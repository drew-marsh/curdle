{
  "name": "curdle",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc",
    "build": "tsc && vite build",
    "lint": "oxlint --max-warnings 0",
    "preview": "vite preview",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest",
    "bench": "vitest bench --run --reporter=verbose",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test run",
    "bench:minimax": "tsx src/scripts/bench-minimax.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=11.20.0",
      "onFail": "warn"
    }
  }
}
